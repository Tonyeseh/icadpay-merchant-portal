# Copy to `.env.local` and adjust. `.env.local` is gitignored.

# API origin (no trailing slash). Required for browser requests unless you terminate `/api` on the same host as this SPA.
# Example: https://localhost:5113
VITE_API_BASE_URL=

# Optional. Public URL to merchant terms (opens in a new tab from onboarding / signup).
# VITE_MERCHANT_TERMS_URL=https://example.com/legal/merchant-terms
